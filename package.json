{
  "name": "pico-spatial-mcp",
  "version": "14.8.0",
  "description": "MCP server for driving PICO XR spatial development: PICO OS6 Emulator lifecycle, adb automation, spatialbundle/Gradle build pipeline, and experimental gRPC XR input injection.",
  "type": "module",
  "bin": {
    "pico-spatial-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "test:lint": "node test/lint.mjs",
    "test:vault": "node test/vault.mjs",
    "test:semantic": "node test/semanticplace.mjs",
    "test:ledger": "node test/ledger.mjs",
    "test:eye": "node test/eye.mjs",
    "test:assetgate": "node test/assetgate.mjs",
    "test:worldenv": "node test/worldenv.mjs",
    "test:referring": "node test/referring.mjs",
    "test:doors": "node test/doors.mjs",
    "test:claims": "node test/claimspage.mjs",
    "test:bench": "node test/spatialbench.mjs",
    "test:affordance": "node test/affordance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
