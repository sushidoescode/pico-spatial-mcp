{
  "mcpServers": {
    "pico_iteration_fixture": {
      "type": "stdio",
      "command": "node",
      "args": ["REPO_PATH/dist/index.js"],
      "timeout": 600000,
      "trust": false,
      "includeTools": ["pico_doctor", "pico_interaction"],
      "env": {
        "PICO_MCP_SURFACE": "doors",
        "PICO_MCP_INTERACTION": "1",
        "PICO_MCP_CLI_POLICY": "managed-cached",
        "PICO_ADB": "/fixture/no/such/adb"
      }
    }
  }
}
