node_modules/
dist/
*.log
.DS_Store
.idea/
.vscode/

# Python bytecode (host-side bridge tools)
__pycache__/
*.pyc

# Internal dev docs (roadmaps, handoffs, findings, guides) — local working memory, not public
.dev/

# Secrets + emulator state (never publish)
adbkey
adbkey.pub
emu-last-feature-flags.protobuf

# pico-cli setup drops local plugin context at the repo root — local wiring, not repo content
/CLAUDE.md
/PICO-SPATIAL-AGENTIC-TOOLS.AGENTS.md
test/.*.tmp.mjs

# stray MCP client artifacts
.playwright-mcp/

# Isolated feature worktrees (never package or commit their contents)
.worktrees/
.firecrawl/

# distribution tarballs are built artifacts — hand testers a Release asset, never a committed binary
*.tgz

# secrets — never commit (a live API key sat here untracked on 2026-08-05)
.env
.env.*
!.env.example
*.key
*.pem

# internal session notes, not part of any deliverable
HANDOFF.md
NEXT-AGENT-PROMPT.md
evidence-frame-drift-*.png
.superpowers/

# pico-cli host wiring written by `pico-cli setup` (machine-local, like the root CLAUDE.md)
/.cursor/
/.pico-env.json

# build-source scratch: the setup lock plus the staging/backup trees a publication owns for its
# lifetime. Each is removed by the build that created it; none is ever repo content.
/.pico-source-setup.lock
/.dist-staging-*
/.dist-backup-*
